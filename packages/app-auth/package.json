  "devDependencies": {
    "@resolid/app-db": "workspace:^",
    "kysely": "^0.29.7",
    "react-router": "^8.5.1",
    "tsdown": "^0.23.3",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@resolid/app-db": "workspace:^",
    "@resolid/app-log": "workspace:^",
    "kysely": "^0.29.7",
    "react-hook-form": "^7.90.0",
    "react-router": "^8.5.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": "^22.22.0 || >=24"
