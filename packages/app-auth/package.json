{
  "name": "@resolid/app-auth",
  "version": "0.0.0",
  "private": true,
  "description": "Auth module for Resolid applications",
  "keywords": [
    "auth",
    "resolid"
  ],
  "homepage": "https://www.resolid.tech",
  "license": "MIT",
  "author": {
    "name": "Huijie Wei",
    "email": "hello@resolid.tech"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/resolid/framework.git",
    "directory": "packages/app-auth"
  },
  "files": [
    "dist"
  ],
  "type": "module",
