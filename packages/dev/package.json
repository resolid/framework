{
  "name": "@resolid/dev",
  "version": "0.14.1",
  "private": false,
  "description": "Development utils for Resolid applications",
  "keywords": [
    "netlify",
    "nodejs",
    "react-router",
    "resolid",
    "vercel",
    "vite"
  ],
  "homepage": "https://www.resolid.tech",
  "license": "MIT",
  "author": {
    "name": "Huijie Wei",
    "email": "hello@resolid.tech"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/resolid/framework.git",
    "directory": "packages/dev"
  },
  "files": [
    "dist",
    "env.d.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./env": {
      "types": "./env.d.ts"
    },
    "./http": {
      "types": "./dist/http.d.mts",
      "import": "./dist/http.mjs"
    },
    "./react": {
      "types": "./dist/react.d.mts",
      "import": "./dist/react.mjs"
    },
    "./routes": {
      "types": "./dist/routes.d.mts",
      "import": "./dist/routes.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@resolid/utils": "^2.0.0",
    "@vercel/nft": "^1.11.1",
    "hono": "^4.13.17",
    "minimatch": "^10.2.6",
    "rolldown": "^1.3.1",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@netlify/types": "^3.3.1",
    "@react-router/dev": "^8.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-router": "^8.5.1",
    "tsdown": "^0.23.7",
    "vite": "^8.3.7"
  },
  "peerDependencies": {
    "@netlify/types": "^3.3.1",
    "@react-router/dev": "^8.5.1",
    "isbot": "^5.2.3",
    "react": "^19.3.1",
    "react-router": "^8.5.1",
    "vite": "^8.3.7"
  },
  "peerDependenciesMeta": {
    "@netlify/types": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.22.0 || >=24"
  }
}
