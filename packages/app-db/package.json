{
  "name": "@resolid/app-db",
  "version": "0.0.0",
  "private": true,
  "description": "Database module for Resolid applications",
  "keywords": [
    "database",
    "db",
    "kysely",
    "orm",
    "resolid"
  ],
  "homepage": "https://www.resolid.tech",
  "license": "MIT",
  "author": {
    "name": "Huijie Wei",
    "email": "hello@resolid.tech"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/resolid/framework.git",
    "directory": "packages/app-db"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./adapters/*": {
      "types": "./dist/adapters/*.d.mts",
      "import": "./dist/adapters/*.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@resolid/app": "workspace:^"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/pg": "^8.23.1",
    "kysely": "^0.29.7",
    "tsdown": "^0.23.1"
  },
  "peerDependencies": {
    "better-sqlite3": "^13.0.3",
    "kysely": "^0.29.7",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.22.0 || >=24"
  }
}
