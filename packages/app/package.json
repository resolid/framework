{
  "name": "@resolid/app",
  "version": "0.0.0",
  "private": true,
  "description": "Application runtime for Resolid applications",
  "keywords": [
    "framework",
    "resolid"
  ],
  "homepage": "https://www.resolid.tech",
  "license": "MIT",
  "author": {
    "name": "Huijie Wei",
    "email": "hello@resolid.tech"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/resolid/framework.git",
    "directory": "packages/app"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./validate": {
      "types": "./dist/validate.d.mts",
      "import": "./dist/validate.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.2",
    "@resolid/di": "workspace:^",
    "@resolid/event": "workspace:^"
  },
  "devDependencies": {
    "react-hook-form": "^7.91.0",
    "tsdown": "^0.23.3"
  },
  "peerDependencies": {
    "react-hook-form": "^7.90.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": "^22.22.0 || >=24"
  }
}
