{
  "name": "resolid-framework",
  "private": true,
  "description": "A modern full-stack framework for building fast, scalable, and maintainable web applications.",
  "homepage": "https://www.resolid.tech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/resolid/framework.git"
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=./website",
    "build": "turbo run build",
    "start:site": "pnpm run --filter ./website start:site",
    "start:admin": "pnpm run --filter ./website start:admin",
    "test:packages": "turbo run test --filter=./packages/*",
    "build:packages": "turbo run build --filter=./packages/*",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "oxfmt",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@resolid/config": "^6.3.13",
    "@tailwindcss/language-server": "^0.16.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.2.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "turbo": "^2.11.13",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": "^22.22.0 || >=24"
  },
  "packageManager": "pnpm@12.21.0"
}
