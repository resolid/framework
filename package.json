{
  "name": "resolid-framework",
  "private": true,
  "description": "A modern full-stack framework for building fast, scalable, and maintainable web applications.",
  "homepage": "https://www.resolid.tech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/resolid/framework.git"
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=./website",
    "build": "turbo run build",
    "build:vercel": "VERCEL=1 turbo run build",
    "build:netlify": "NETLIFY=true turbo run build",
    "start:site": "pnpm run --filter ./website start:site",
    "start:admin": "pnpm run --filter ./website start:admin",
    "test:packages": "turbo run test --filter=./packages/*",
    "build:packages": "turbo run build --filter=./packages/*",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "oxfmt",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@resolid/config": "^6.3.2",
    "@tailwindcss/language-server": "^0.16.0",
    "@types/node": "^24.13.4",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.10.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": "^22.22.0 || >=24"
  },
  "packageManager": "pnpm@12.4.2"
}
