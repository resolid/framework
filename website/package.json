{
  "name": "website",
  "private": true,
  "description": "The Resolid Website.",
  "homepage": "https://www.resolid.tech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/resolid/framework.git",
    "directory": "website"
  },
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "lint": "oxlint",
    "start:site": "NODE_ENV=production SERVER_PORT=3001 node --env-file=.env ./build/server/site/server.mjs",
    "start:admin": "NODE_ENV=production SERVER_PORT=3002 SERVER_PATH=admin node --env-file=.env ./build/server/admin/server.mjs",
    "typecheck": "react-router typegen && tsc --noEmit",
    "typegen": "react-router typegen"
  },
  "dependencies": {
    "@logtape/file": "^2.4.2",
    "@marsidev/react-turnstile": "^1.6.3",
    "@resolid/app": "workspace:^",
    "@resolid/app-auth": "workspace:^",
    "@resolid/app-cache": "workspace:^",
    "@resolid/app-db": "workspace:^",
    "@resolid/app-log": "workspace:^",
    "@resolid/app-mail": "workspace:^",
    "@resolid/cache-file": "^1.2.0",
    "@resolid/cache-redis": "^1.2.0",
    "@resolid/react-ui": "^0.3.8",
    "@resolid/utils": "^2.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "bowser": "^2.15.0",
    "isbot": "^5.2.3",
    "kysely": "^0.29.8",
    "mysql2": "^3.24.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.8",
    "react-hook-form": "^7.91.0",
    "react-router": "^8.5.1",
    "remix-hook-form": "^7.3.0",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@react-router/dev": "^8.5.1",
    "@resolid/dev": "workspace:^",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "vite": "^8.3.7"
  },
  "engines": {
    "node": "^22.22.0 || >=24"
